# Copy to .env.local. `npm run dev` is mock mode unless you set CHILLRIG_MOCK=false.

# true = full UI without Stripe, Supabase, or Hetzner.
# Production ignores this unless it is explicitly true.
CHILLRIG_MOCK=true

# Public hostname of the control plane. The VM calls this for auth and the ready callback.
# On Vercel, set both to the stable https://<project>.vercel.app origin.
# If they are unset, the app uses VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
CHILLRIG_CONTROL_PLANE=https://app.example.com

# Apex domain. Each box is https://<slug>.<domain> when Cloudflare is configured.
# Leave CLOUDFLARE_* empty to skip DNS and use <ip-with-dashes>.sslip.io instead.
CHILLRIG_DOMAIN=chillrig.test

# Show email magic-link / OTP on the sign-in page. Use this before Google and GitHub apps exist.
# CHILLRIG_EMAIL_LOGIN=1
# Show Google and GitHub buttons once those Supabase providers are enabled.
# CHILLRIG_OAUTH=1
# Also show a one-time-code box. Needs custom SMTP and an email template with {{ .Token }}.
# CHILLRIG_EMAIL_CODE=1

# Signs the session cookie and the short-lived box tickets. Required in production.
SESSION_SECRET=
TERMINAL_TOKEN_SECRET=

# Supabase Auth (Google + GitHub) and Postgres.
# NEXT_PUBLIC_* names also work. The anon key is public; the service role is not.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Create a €29/month EUR price with tax behavior "inclusive".
# Do not enable automatic tax, or the charge will not match the €29 display.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Printed by `npm run stripe-setup`. Optional when the Customer Portal default already exists.
STRIPE_PORTAL_CONFIGURATION=
# Set to 1 once Stripe Tax is active (head office + registrations) to have Checkout compute VAT.
STRIPE_AUTOMATIC_TAX=

# Hetzner Cloud. cx33 (4 vCPU / 8 GB, about €8.49–€8.99) in fsn1, then nbg1 and hel1.
# If that type is unavailable, try cax21, then cx23. Nothing above €12 is chosen.
HETZNER_API_TOKEN=
HETZNER_LOCATION=fsn1
HETZNER_LOCATIONS=fsn1,nbg1,hel1
HETZNER_SERVER_TYPES=cx33,cax21,cx23
HETZNER_MAX_MONTHLY_EUR=12

# Cloudflare DNS. Optional. When both are set, each box gets an A record at <slug>.<domain>.
# When either is unset, the box hostname is <ip-with-dashes>.sslip.io and no DNS setup is required.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional email when a box is ready.
RESEND_API_KEY=
EMAIL_FROM="Chillrig <ready@example.com>"

# Let's Encrypt contact on the box.
ACME_EMAIL=ops@example.com

# Optional. Shorten the demo provisioning animation, in milliseconds.
# CHILLRIG_MOCK_PROVISION_MS=7000
